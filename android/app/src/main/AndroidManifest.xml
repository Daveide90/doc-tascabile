<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- La rete serve solo al «Timestamp con blockchain»: manda l'impronta di un file ai server pubblici di
         OpenTimestamps e prende l'intestazione di un blocco da un esploratore. I documenti restano
         sul telefono. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- La modalità riservata: da Android 12 le finestre di altre app non stanno sopra la nostra
         (setHideOverlayWindows). Permesso normale, senza domande. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- L'impronta o il PIN prima di usare la firma salvata (BiometricPrompt). Permesso normale. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- «Accesso a tutti i file»: aprire e salvare i documenti dove stanno (Download, Documenti,
         allegati di WhatsApp). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Niente backup: allowBackup per Android 11, le regole (res/xml/regole_dati.xml) da Android 12
         anche per il trasferimento da telefono a telefono. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Tascabile"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/regole_dati"
        android:networkSecurityConfig="@xml/rete">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="colorMode|density|fontScale|fontWeightAdjustment|grammaticalGender|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode">

            <!-- GameActivity carica lib<nome>.so: qui libtascabile.so -->
            <meta-data android:name="android.app.lib_name" android:value="tascabile" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- «Apri con» da WhatsApp, Telegram, file manager, posta: i documenti di testo e, dalla
             tappa D, i PDF da leggere. Arriva qui e non a MainActivity (7/11/2026): quando
             l'altra app passa dal selettore di Android chiedendo un risultato, Android ignora
             singleTask e crea una seconda MainActivity nel suo task, nello stesso processo, che
             non disegna mai e blocca l'app su bianco. Questa attività gira il file a MainActivity
             con NEW_TASK e si chiude: la finestra dell'app resta una. È visibile (il colore carta
             dell'avvio) e a finestra unica in un task suo, come MainActivity: invisibile
             (NoDisplay) e nel task dell'altra app, il telefono la creava senza mai avviare il
             processo, e ad app chiusa l'«Apri con» non partiva (prova del 7/11 sera). -->
        <activity
            android:name=".ApriConActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="it.tascabile.app.apricon"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:autoRemoveFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="application/msword" />
                <data android:mimeType="application/vnd.oasis.opendocument.text" />
                <data android:mimeType="application/rtf" />
                <!-- Revisione del 10/11: Android dichiara i .rtf come text/rtf, e l'app non si
                     offriva; lo stesso per i modelli e i documenti con macro di Word, che apre. -->
                <data android:mimeType="text/rtf" />
                <data android:mimeType="application/x-rtf" />
                <data android:mimeType="application/vnd.ms-word.document.macroenabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.template" />
                <data android:mimeType="application/vnd.ms-word.template.macroenabled.12" />
                <data android:mimeType="application/pdf" />
                <!-- Le presentazioni che si aprono (tappa G): .pptx, .ppsx, .potx. Non .ppt né .odp:
                     l'app comparirebbe in «Apri con» per poi dire che non li legge. -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.presentation" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.slideshow" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.presentationml.template" />
                <!-- I fogli di calcolo, in sola lettura (0.9.0): Excel, il vecchio .xls, LibreOffice,
                     il testo separato da virgole. -->
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/vnd.ms-excel.sheet.macroenabled.12" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.template" />
                <data android:mimeType="application/vnd.ms-excel.template.macroenabled.12" />
                <data android:mimeType="application/vnd.ms-excel.sheet.binary.macroenabled.12" />
                <data android:mimeType="application/vnd.oasis.opendocument.spreadsheet" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
            </intent-filter>
            <!-- I documenti che un'altra app manda senza dirne il tipo (application/octet-stream:
                 succede con Telegram e con alcuni gestori di file). Revisione del 10/11: l'app non
                 si offriva, e per aprirli bisognava passare da «Apri» dentro l'app. Qui conta
                 l'estensione nel percorso dell'URI, così l'app non si offre mai per un file
                 qualunque; che cosa c'è dentro lo decide poi l'app dai byte, non dal nome.
                 Il filtro è a parte: nello stesso filtro i percorsi varrebbero per tutti i tipi, e
                 un PDF con un URI senza nome non si aprirebbe più. android:host="*" serve perché
                 senza un host Android ignora i percorsi, e il filtro prenderebbe ogni file.
                 Il motivo di Android (pathPattern) si ferma al primo punto che trova e non torna
                 indietro: serve una riga per ogni numero di punti nel percorso, da uno a sei, e
                 una per le maiuscole. Le righe sono generate: 17 estensioni × 2 × 6. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.docx" />
                <data android:pathPattern=".*\\..*\\.docx" />
